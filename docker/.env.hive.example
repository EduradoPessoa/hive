# Copie para `.env` (na mesma pasta do docker-compose.hive.yml) e preencha.
# Nunca envie o `.env` para o Git.

# Obrigatório. Segredo para assinar as sessões de login. Gere um valor próprio:
#   macOS / Linux / WSL2:  openssl rand -hex 32
#   Windows (PowerShell):  $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
BETTER_AUTH_SECRET=

# Chaves dos provedores de IA. Preencha pelo menos uma para os agentes
# trabalharem (o Hive sobe e funciona sem elas).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Opcionais
# HIVE_PORT=3100
# PAPERCLIP_PUBLIC_URL=http://localhost:3100
# PAPERCLIP_ALLOWED_HOSTNAMES=
